
function print_usage {
	echo "Usage:"
	echo "$0 thenbuildname nowbuildname thenlogsdir nowlogsdir file_listing_PR_pkgs"
	echo "thenbuildname - the name with which you want to identify the then build" 	
	echo "nowbuildname - the name with which you want to identify the now build"
	echo "thenlogsdir - fully qualified path to the directory where the BuildLoogs.txt file for the then build is kept"
	echo "nowlogsdir - fully qualified path to the directory where the BuildLoogs.txt file for the now build is kept"
	echo "file_listing_PR_pkgs - fully qualified path to the file that lists the Packages for which PRs have been raised."
	exit
}

function clean_up {
    echo "====== Cleaning up ======"

    if [[ -f "$WORKING_TEMP_FILE" ]]
    then
        rm -rf "$WORKING_TEMP_FILE"
    fi
}
trap clean_up EXIT SIGINT SIGTERM

if [ $# -ne 5 ]
then
	echo "5 arguments needed as follows:"
	print_usage
fi

#Name of then build
#thenbuildnm="03Apr"
thenbuildnm=$1
#Name of now build
#nowbuildnm="17Apr"
nowbuildnm=$2
#Fully qualified path to the directory where the BuildLogs.txt file for the then build is present. 
#thendir="/mnt/c/Users/v-nsallh/Junk/PipelineBuilds/CopyOneBranch_Daily_03Apr_777677"
thendir=$3
#Fully qualified path to the directory where the BuildLogs.txt file for the now build is present. 
#nowdir="/mnt/c/Users/v-nsallh/Junk/PipelineBuilds/OneBranch_Daily_17Apr_784735"
nowdir=$4
#Fully qualified path to a file that contains list of package names for which PRs have been raised.
#pkgPRMapfile="/mnt/c/Users/v-nsallh/Junk/PipelineBuilds/pkgnm_PRs_04Apr.txt"
pkgPRMapfile=$5

if [ ! -f $pkgPRMapfile ]
then
	echo "The fifth argument $pkgPRMapfile is not a file"
	print_usage
fi

if [ ! -d $thendir ]
then
	echo "The third argument $thendir is not a directory"
	print_usage
fi

if [ ! -d $nowdir ]
then
	echo "The fourth argument $nowdir is not a directory"
	print_usage
fi

if [ $nowdir = $thendir ]
then
	echo "The two directories $nowdir and $thendir must be different"
	echo "Else the listing files will be corrupted"
	print_usage
fi

FtoNF_fname="${thenbuildnm}_Failed_to_${nowbuildnm}_nonFailed.csv"

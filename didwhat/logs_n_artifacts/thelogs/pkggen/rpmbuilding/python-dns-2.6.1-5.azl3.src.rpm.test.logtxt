time="2025-03-18T17:41:23Z" level=debug msg="    def test_getaddrinfo_service(self):"
time="2025-03-18T17:41:23Z" level=debug msg=">       a = socket.getaddrinfo(\"dns.google\", \"domain\")"
time="2025-03-18T17:41:23Z" level=debug
time="2025-03-18T17:41:23Z" level=debug msg="tests/test_resolver_override.py:145: "
time="2025-03-18T17:41:23Z" level=debug msg="_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ "
time="2025-03-18T17:41:23Z" level=debug
time="2025-03-18T17:41:23Z" level=debug msg="host = 'dns.google', service = 'domain', family = <AddressFamily.AF_UNSPEC: 0>"
time="2025-03-18T17:41:23Z" level=debug msg="socktype = 0, proto = 0, flags = 0"
time="2025-03-18T17:41:23Z" level=debug
time="2025-03-18T17:41:23Z" level=debug msg="    def _getaddrinfo("
time="2025-03-18T17:41:23Z" level=debug msg="        host=None, service=None, family=socket.AF_UNSPEC, socktype=0, proto=0, flags=0"
time="2025-03-18T17:41:23Z" level=debug msg="    ):"
time="2025-03-18T17:41:23Z" level=debug msg="        if flags & socket.AI_NUMERICHOST != 0:"
time="2025-03-18T17:41:23Z" level=debug msg="            # Short circuit directly into the system's getaddrinfo().  We're"
time="2025-03-18T17:41:23Z" level=debug msg="            # not adding any value in this case, and this avoids infinite loops"
time="2025-03-18T17:41:23Z" level=debug msg="            # because dns.query.* needs to call getaddrinfo() for IPv6 scoping"
time="2025-03-18T17:41:23Z" level=debug msg="            # reasons.  We will also do this short circuit below if we"
time="2025-03-18T17:41:23Z" level=debug msg="            # discover that the host is an address literal."
time="2025-03-18T17:41:23Z" level=debug msg="            return _original_getaddrinfo(host, service, family, socktype, proto, flags)"
time="2025-03-18T17:41:23Z" level=debug msg="        if flags & (socket.AI_ADDRCONFIG | socket.AI_V4MAPPED) != 0:"
time="2025-03-18T17:41:23Z" level=debug msg="            # Not implemented.  We raise a gaierror as opposed to a"
time="2025-03-18T17:41:23Z" level=debug msg="            # NotImplementedError as it helps callers handle errors more"
time="2025-03-18T17:41:23Z" level=debug msg="            # appropriately.  [Issue #316]"
time="2025-03-18T17:41:23Z" level=debug msg="            #"
time="2025-03-18T17:41:23Z" level=debug msg="            # We raise EAI_FAIL as opposed to EAI_SYSTEM because there is"
time="2025-03-18T17:41:23Z" level=debug msg="            # no EAI_SYSTEM on Windows [Issue #416].  We didn't go for"
time="2025-03-18T17:41:23Z" level=debug msg="            # EAI_BADFLAGS as the flags aren't bad, we just don't"
time="2025-03-18T17:41:23Z" level=debug msg="            # implement them."
time="2025-03-18T17:41:23Z" level=debug msg="            raise socket.gaierror("
time="2025-03-18T17:41:23Z" level=debug msg="                socket.EAI_FAIL, \"Non-recoverable failure in name resolution\""
time="2025-03-18T17:41:23Z" level=debug msg="            )"
time="2025-03-18T17:41:23Z" level=debug msg="        if host is None and service is None:"
time="2025-03-18T17:41:23Z" level=debug msg="            raise socket.gaierror(socket.EAI_NONAME, \"Name or service not known\")"
time="2025-03-18T17:41:23Z" level=debug msg="        addrs = []"
time="2025-03-18T17:41:23Z" level=debug msg="        canonical_name = None  # pylint: disable=redefined-outer-name"
time="2025-03-18T17:41:23Z" level=debug msg="        # Is host None or an address literal?  If so, use the system's"
time="2025-03-18T17:41:23Z" level=debug msg="        # getaddrinfo()."
time="2025-03-18T17:41:23Z" level=debug msg="        if host is None:"
time="2025-03-18T17:41:23Z" level=debug msg="            return _original_getaddrinfo(host, service, family, socktype, proto, flags)"
time="2025-03-18T17:41:23Z" level=debug msg="        try:"
time="2025-03-18T17:41:23Z" level=debug msg="            # We don't care about the result of af_for_address(), we're just"
time="2025-03-18T17:41:23Z" level=debug msg="            # calling it so it raises an exception if host is not an IPv4 or"
time="2025-03-18T17:41:23Z" level=debug msg="            # IPv6 address."
time="2025-03-18T17:41:23Z" level=debug msg="            dns.inet.af_for_address(host)"
time="2025-03-18T17:41:23Z" level=debug msg="            return _original_getaddrinfo(host, service, family, socktype, proto, flags)"
time="2025-03-18T17:41:23Z" level=debug msg="        except Exception:"
time="2025-03-18T17:41:23Z" level=debug msg="            pass"
time="2025-03-18T17:41:23Z" level=debug msg="        # Something needs resolution!"
time="2025-03-18T17:41:23Z" level=debug msg="        try:"
time="2025-03-18T17:41:23Z" level=debug msg="            answers = _resolver.resolve_name(host, family)"
time="2025-03-18T17:41:23Z" level=debug msg="            addrs = answers.addresses_and_families()"
time="2025-03-18T17:41:23Z" level=debug msg="            canonical_name = answers.canonical_name().to_text(True)"
time="2025-03-18T17:41:23Z" level=debug msg="        except dns.resolver.NXDOMAIN:"
time="2025-03-18T17:41:23Z" level=debug msg="            raise socket.gaierror(socket.EAI_NONAME, \"Name or service not known\")"
time="2025-03-18T17:41:23Z" level=debug msg="        except Exception:"
time="2025-03-18T17:41:23Z" level=debug msg="            # We raise EAI_AGAIN here as the failure may be temporary"
time="2025-03-18T17:41:23Z" level=debug msg="            # (e.g. a timeout) and EAI_SYSTEM isn't defined on Windows."
time="2025-03-18T17:41:23Z" level=debug msg="            # [Issue #416]"
time="2025-03-18T17:41:23Z" level=debug msg="            raise socket.gaierror(socket.EAI_AGAIN, \"Temporary failure in name resolution\")"
time="2025-03-18T17:41:23Z" level=debug msg="        port = None"
time="2025-03-18T17:41:23Z" level=debug msg="        try:"
time="2025-03-18T17:41:23Z" level=debug msg="            # Is it a port literal?"
time="2025-03-18T17:41:23Z" level=debug msg="            if service is None:"
time="2025-03-18T17:41:23Z" level=debug msg="                port = 0"
time="2025-03-18T17:41:23Z" level=debug msg="            else:"
time="2025-03-18T17:41:23Z" level=debug msg="                port = int(service)"
time="2025-03-18T17:41:23Z" level=debug msg="        except Exception:"
time="2025-03-18T17:41:23Z" level=debug msg="            if flags & socket.AI_NUMERICSERV == 0:"
time="2025-03-18T17:41:23Z" level=debug msg="                try:"
time="2025-03-18T17:41:23Z" level=debug msg="                    port = socket.getservbyname(service)"
time="2025-03-18T17:41:23Z" level=debug msg="                except Exception:"
time="2025-03-18T17:41:23Z" level=debug msg="                    pass"
time="2025-03-18T17:41:23Z" level=debug msg="        if port is None:"
time="2025-03-18T17:41:23Z" level=debug msg=">           raise socket.gaierror(socket.EAI_NONAME, \"Name or service not known\")"
time="2025-03-18T17:41:23Z" level=debug msg="E           socket.gaierror: [Errno -2] Name or service not known"

			ver = name_parts[2] 
			rel = name_parts[3] 
			#print(f'For the srpm {srpm_file_name}, the version is {ver} and release is {rel}')

			#filpathstr=BULK_BUILD_ROOT + "/out/SRPMS/" + package_name + "-" + ver + "-" + rel + ".azl3.src.rpm"
			#file=Path(filpathstr)
			#if ( file.is_file(filpathstr) ):
			pathstr = BULK_BUILD_ROOT + "/out/SRPMS/" 
			filnamestr = package_name + "-" + ver + "-*.azl3.src.rpm"
			#print (f'Will be looking for file {pathstr}{filnamestr}')
			found_built_file = 0
			for path in Path(pathstr).glob(filnamestr):
				#print (f'Found {filnamestr} as {path}')
				found_built_file = found_built_file + 1
				bulk_build_success_count = bulk_build_success_count + 1
			#if ( 0 == found_built_file ):
				#print (f'Missing {pathstr}{filnamestr}')

		#print (f'bulk_build_success_count {bulk_build_success_count} / dl_srpm_count {dl_srpm_count}')
		if ( bulk_build_success_count < dl_srpm_count ):
			bulk_build_success = 'N'
			#print (f'Bulk build fail for {pkname}.  Generated count {bulk_build_success_count}, Expected count {dl_srpm_count}')
		else:
			bulk_build_success = 'Y'

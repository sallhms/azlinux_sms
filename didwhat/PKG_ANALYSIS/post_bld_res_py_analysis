						#print(f'Full string:{name_parts[0]}, package name:{name_parts[1]}, version:{name_parts[2]}, release:{name_parts[3]}')
						dnld_ver = name_parts[2] 
						dnld_rel = name_parts[3] 
						#print(f'For the first srpm version is {dnld_ver} and release is {dnld_rel}')
				#for libldb only use the version number from that downloaded srpm which is libldb.*.src.rpm
				elif ( 'libldb' == pkname ):
					#hard coding the ver and rel because extracting those from one of the multiple srpms
					#downloaded was a complex thing.  Requires going through the list of downloaded srpms
					#and also the lines for these downloads are not as simple as the cases where single
					#srpm is downloaded, because these lines for multiples downloads include (1/2): and 
					#(2/2): etc in the start.
					dnld_ver = '2.9.1'
					dnld_rel = '4'
							
				if ( 1 <= dl_srpm_count ):
					dl_srpm1 = dnld_det_srpmlist[0]
				if ( 2 <= dl_srpm_count ):
					dl_srpm2 = dnld_det_srpmlist[1]
				if ( 3 <= dl_srpm_count ):
					dl_srpm3 = dnld_det_srpmlist[2]
				break

	if ( 1 != in_pk_section ):
		#print (f'{pkname}: Not in downloads')
		dnld_det_success = 0


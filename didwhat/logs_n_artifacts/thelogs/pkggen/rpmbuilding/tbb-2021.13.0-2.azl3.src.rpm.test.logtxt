time="2025-03-18T21:43:26Z" level=debug msg=".. tabs::"
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="   .. group-tab:: Windows* OS"
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="      #. Create a new C++ project using your IDE. In this example, Microsoft* Visual Studio* Code is used."
time="2025-03-18T21:43:26Z" level=debug msg="      #. Create an ``example.cpp`` file in the project."
time="2025-03-18T21:43:26Z" level=debug msg="      #. Copy and paste the code below. It is a typical example of a |short_name| algorithm. The sample calculates a sum of all integer numbers from 1 to 100."
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="         .. code::"
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="            #include <oneapi/tbb.h>"
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="            int main (){"
time="2025-03-18T21:43:26Z" level=debug msg="                int sum = oneapi::tbb::parallel_reduce("
time="2025-03-18T21:43:26Z" level=debug msg="                    oneapi::tbb::blocked_range<int>(1,101), 0,"
time="2025-03-18T21:43:26Z" level=debug msg="                    [](oneapi::tbb::blocked_range<int> const& r, int init) -> int {"
time="2025-03-18T21:43:26Z" level=debug msg="                        for (int v = r.begin(); v != r.end(); v++) {"
time="2025-03-18T21:43:26Z" level=debug msg="                            init += v;"
time="2025-03-18T21:43:26Z" level=debug msg="                        }"
time="2025-03-18T21:43:26Z" level=debug msg="                        return init;"
time="2025-03-18T21:43:26Z" level=debug msg="                    },"
time="2025-03-18T21:43:26Z" level=debug msg="                    [](int lhs, int rhs) -> int {"
time="2025-03-18T21:43:26Z" level=debug msg="                        return lhs + rhs;"
time="2025-03-18T21:43:26Z" level=debug msg="                    }"
time="2025-03-18T21:43:26Z" level=debug msg="                );"
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="                printf(\"Sum: %d\\n\", sum);"
time="2025-03-18T21:43:26Z" level=debug msg="                return 0;"
time="2025-03-18T21:43:26Z" level=debug msg="            }"
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="      #. Open the ``tasks.json`` file in the ``.vscode`` directory and paste the following lines to the args array:"
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="         * ``-Ipath/to/oneTBB/include`` to add oneTBB include directory."
time="2025-03-18T21:43:26Z" level=debug msg="         * ``path/to/oneTBB/`` to add oneTBB."
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="         For example:"
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="         .. code-block::"
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="                {"
time="2025-03-18T21:43:26Z" level=debug msg="                   \"tasks\": ["
time="2025-03-18T21:43:26Z" level=debug msg="                        {"
time="2025-03-18T21:43:26Z" level=debug msg="                           \"label\": \"build & run\","
time="2025-03-18T21:43:26Z" level=debug msg="                           \"type\": \"cppbuild\","
time="2025-03-18T21:43:26Z" level=debug msg="                           \"group\": {"
time="2025-03-18T21:43:26Z" level=debug msg="                           \"args\": ["
time="2025-03-18T21:43:26Z" level=debug msg="                               \"/IC:\\\\Program Files (x86)\\\\Intel\\\\oneAPI\\\\tbb\\\\2021.9.0\\\\include\","
time="2025-03-18T21:43:26Z" level=debug msg="                               \"C:\\\\Program Files (x86)\\\\Intel\\\\oneAPI\\\\tbb\\\\2021.9.0\\\\lib\\\\ia32\\\\vc14\\\\tbb12.lib\""
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="      #. Build the project."
time="2025-03-18T21:43:26Z" level=debug msg="      #. Run the example."
time="2025-03-18T21:43:26Z" level=debug msg="      #. If oneTBB is configured correctly, the output displays ``Sum: 5050``."
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="   .. group-tab:: Linux* OS"
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="      #. Create an ``example.cpp`` file in the project."
time="2025-03-18T21:43:26Z" level=debug msg="      #. Copy and paste the code below. It is a typical example of a |short_name| algorithm. The sample calculates a sum of all integer numbers from 1 to 100."
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="         .. code::"
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="            #include <oneapi/tbb.h>"
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="            int main(){"
time="2025-03-18T21:43:26Z" level=debug msg="                int sum = oneapi::tbb::parallel_reduce("
time="2025-03-18T21:43:26Z" level=debug msg="                    oneapi::tbb::blocked_range<int>(1,101), 0,"
time="2025-03-18T21:43:26Z" level=debug msg="                    [](oneapi::tbb::blocked_range<int> const& r, int init) -> int {"
time="2025-03-18T21:43:26Z" level=debug msg="                        for (int v = r.begin(); v != r.end(); v++) {"
time="2025-03-18T21:43:26Z" level=debug msg="                            init += v;"
time="2025-03-18T21:43:26Z" level=debug msg="                        }"
time="2025-03-18T21:43:26Z" level=debug msg="                        return init;"
time="2025-03-18T21:43:26Z" level=debug msg="                    },"
time="2025-03-18T21:43:26Z" level=debug msg="                    [](int lhs, int rhs) -> int {"
time="2025-03-18T21:43:26Z" level=debug msg="                        return lhs + rhs;"
time="2025-03-18T21:43:26Z" level=debug msg="                    }"
time="2025-03-18T21:43:26Z" level=debug msg="                );"
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="                printf(\"Sum: %d\\n\", sum);"
time="2025-03-18T21:43:26Z" level=debug msg="                return 0;"
time="2025-03-18T21:43:26Z" level=debug msg="            }"
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="      #. Compile the code using oneTBB. For example,"
time="2025-03-18T21:43:26Z" level=debug
time="2025-03-18T21:43:26Z" level=debug msg="         .. code-block::"



PROG_NAME=$0
print_usage()
{
	echo "Usage:"
	echo "${PROG_NAME##*/} src_root_dir build_script_logfile"
	echo "src_root_dir - Root directory of the source that was built"
	echo "build_script_logfile - fully qualified path to the file where build script generated the output logs"
	exit
}

if [ $# -ne 2 ]
then
	echo "Wrong number of arguments"
	print_usage
	exit
fi

sroot_dir=$1
bldscrptlogfl=$2

if [ ! -d $sroot_dir ]
then
	echo "src_root_dir argument - $sroot_dir - must be a directory"
	print_usage
fi
if [ ! -f $bldscrptlogfl ]
then
	echo "build_script_logfile argument - $bldscrptlogfl - must be a file"
	print_usage
fi


d_dir=res_dir-$(date +%Y%m%d-%H%M%S)
echo $d_dir

mkdir -p $d_dir

mkdir -p $d_dir/out
mkdir -p $d_dir/build/
mkdir -p $d_dir/build/pkg_artifacts/

cp $bldscrptlogfl $d_dir
only_fname_logfl=${bldscrptlogfl##*/}

#Create the lists of build Passed/Failed/Blocked/Unresolved from the build logs
#tar zip the build logs to save space
pushd $d_dir

#create lists
echo "Creating the lists of build Passed/Failed/Blocked/Unresolved from the build logs"
cat $bldscrptlogfl | ~/utils/find_failed_from_bld_logs/get_failed_frm_logs | ~/utils/remove_ver_rel/remove_ver_rel_part | sort -u > unqsrtd_Failed_SRPMs_pkgnm
cat $bldscrptlogfl | ~/utils/find_blkd_from_bld_logs/get_blkd_frm_logs | ~/utils/remove_ver_rel/remove_ver_rel_part | sort -u > unqsrtd_Blocked_SRPMs_pkgnm
cat $bldscrptlogfl | ~/utils/find_unres_from_bld_logs/get_unres_frm_logs | ~/utils/remove_ver_rel/remove_ver_rel_part | sort -u > unqsrtd_Unres_SRPMs_pkgnm
cat $bldscrptlogfl | ~/utils/find_built_from_bld_logs/get_built_frm_logs | ~/utils/remove_ver_rel/remove_ver_rel_part | sort -u > unqsrtd_Built_SRPMs_pkgnm

#tar zip the build logs
echo "Creating tar zip for the main build log file"
tar -czf ${only_fname_logfl}.tgz $only_fname_logfl
rm $only_fname_logfl

popd

ls $sroot_dir/out/SRPMS/ >  $d_dir/out/ls_out_SRPMS.txt
ls $sroot_dir/out/RPMS/noarch/> $d_dir/out/ls_out_RPMS_noarch.txt
ls $sroot_dir/out/RPMS/x86_64/> $d_dir/out/ls_out_RPMS_x86_64.txt
tree $sroot_dir/out > $d_dir/out/tree_out.txt

cp -r $sroot_dir/build/pkg_artifacts/build_state.csv $d_dir/build/pkg_artifacts/build_state.csv

pushd $sroot_dir/build
tar -czf $sroot_dir/logs.tgz logs
popd

mv $sroot_dir/logs.tgz $d_dir/build/logs.tgz

		dirpathstr=MSREPO_3DEV_WORKDIR + "/SPECS/" + pkname
		#print (f'dirpathstr is {dirpathstr}')
		file=Path(dirpathstr)
		if ( file.is_dir() ):
			pkg_in_3_core = 1
		else:
			pkg_in_3_core = 0
			
		dirpathstr=MSREPO_3DEV_WORKDIR + "/SPECS-EXTENDED/" + pkname
		#print (f'dirpathstr is {dirpathstr}')
		file=Path(dirpathstr)

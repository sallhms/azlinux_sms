			ver_in_3_dev = spec.version
			#If there are macros in ver_in_3_dev, try to replace them
			if '%' in ver_in_3_dev:
				ver_in_3_dev = replace_macros(spec.version, spec)
			#if even after replacing the macros there are unresolved components remaining
			if '%' in ver_in_3_dev:
				ver_in_3_dev = 'Not Found'
		else:
			ver_in_3_dev = 'No Spec Found'

	#print (f'{pkname} {pkg_existence}')

def parse_version(version):
	# Replace special cases
	version = version.replace('Not_Found', '0').replace('Not_found', '0').replace('_', '.')
	
	# Split the version into components
	# This regex captures numbers, letters, and special characters
	components = re.split(r'(\d+|[a-zA-Z]+|[^0-9a-zA-Z]+)', version)
	# Filter out empty strings and return a list of components
	return [comp for comp in components if comp]

def compare_version(first_ver, sec_ver):
	#print(f'first_ver : {first_ver} , sec_ver : {sec_ver}')
	#first_ver = str(first_ver)
	#sec_ver = str(sec_ver)
	parsed_v1 = parse_version(first_ver)
	parsed_v2 = parse_version(sec_ver)
	#print(f'first_ver parsed: {parsed_v1}, length: {len(parsed_v1)} , sec_ver parsed: {parsed_v2}, length: {len(parsed_v2)}')
	# Compare the parsed components

	if ( len(parsed_v1) != len(parsed_v2) ):
		return 'Revisit Ver Compare'

	for comp1, comp2 in zip(parsed_v1, parsed_v2):
		if str(comp1).isdigit() and str(comp2).isdigit():
			# Compare as integers
			if int(comp1) < int(comp2):
				return 'First Less than second'
			else:
				return 'First Not Less than second'
		else:
			return 'Revisit Ver Compare'

def set_upgrade_reqd(pkname):
	global ver_bld_status
	global dnld_ver
	global upgd_reqd

	upgd_reqd = 'Revisit'

	if ( 'Not Found' == ver_bld_status ):
		upgd_reqd = 'Revisit No Bld Ver'
	elif ('Not Found' == dnld_ver ):
		upgd_reqd = 'Revisit No Dnld Ver'
	else:
		result = compare_version(ver_bld_status, dnld_ver)
		if ( 'First Less than second' == result ):
			upgd_reqd = 'Y'
		elif ( 'First Not Less than second' == result ):
			upgd_reqd = 'N'
		else:
			upgd_reqd = result
		

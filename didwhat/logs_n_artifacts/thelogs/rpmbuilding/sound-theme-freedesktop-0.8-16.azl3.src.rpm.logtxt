time="2025-03-07T05:16:29Z" level=debug msg="Usage: intltool-merge [OPTION]... PO_DIRECTORY FILENAME OUTPUT_FILE"
time="2025-03-07T05:16:29Z" level=debug msg="Generates an output file that includes some localized attributes from an"
time="2025-03-07T05:16:29Z" level=debug msg="untranslated source file."
time="2025-03-07T05:16:29Z" level=debug
time="2025-03-07T05:16:29Z" level=debug msg="Mandatory options: (exactly one must be specified)"
time="2025-03-07T05:16:29Z" level=debug msg="  -b, --ba-style         includes translations in the bonobo-activation style"
time="2025-03-07T05:16:29Z" level=debug msg="  -d, --desktop-style    includes translations in the desktop style"
time="2025-03-07T05:16:29Z" level=debug msg="  -k, --keys-style       includes translations in the keys style"
time="2025-03-07T05:16:29Z" level=debug msg="  -s, --schemas-style    includes translations in the schemas style"
time="2025-03-07T05:16:29Z" level=debug msg="  -r, --rfc822deb-style  includes translations in the RFC822 style"
time="2025-03-07T05:16:29Z" level=debug msg="      --quoted-style     includes translations in the quoted string style"
time="2025-03-07T05:16:29Z" level=debug msg="      --quotedxml-style  includes translations in the quoted xml string style"
time="2025-03-07T05:16:29Z" level=debug msg="  -x, --xml-style        includes translations in the standard xml style"
time="2025-03-07T05:16:29Z" level=debug
time="2025-03-07T05:16:29Z" level=debug msg="Other options:"
time="2025-03-07T05:16:29Z" level=debug msg="  -u, --utf8             convert all strings to UTF-8 before merging "
time="2025-03-07T05:16:29Z" level=debug msg="                         (default for everything except RFC822 style)"
time="2025-03-07T05:16:29Z" level=debug msg="  -p, --pass-through     deprecated, does nothing and issues a warning"
time="2025-03-07T05:16:29Z" level=debug msg="  -m, --multiple-output  output one localized file per locale, instead of "
time="2025-03-07T05:16:29Z" level=debug msg="\t                 a single file containing all localized elements"
time="2025-03-07T05:16:29Z" level=debug msg="      --no-translations  do not merge any translations: only generates the"
time="2025-03-07T05:16:29Z" level=debug msg="                         unlocalised (English) version -- applies only"
time="2025-03-07T05:16:29Z" level=debug msg="                         to XML merging"
time="2025-03-07T05:16:29Z" level=debug msg="  -c, --cache=FILE       specify cache file name"
time="2025-03-07T05:16:29Z" level=debug msg="                         (usually $top_builddir/po/.intltool-merge-cache)"

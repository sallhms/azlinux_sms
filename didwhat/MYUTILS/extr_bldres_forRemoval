

print_usage()
{
	echo "Usage:"
	echo "$0 src_root_dir"
	echo "src_root_dir - Root directory of the source that was built"
}

if [ $# -ne 1 ]
then
	echo "Wrong number of arguments"
	print_usage
	exit
fi

sroot_dir=$1
d_dir=res_dir-$(date +%Y%m%d-%H%M%S)
echo $d_dir

if [ ! -d $sroot_dir ]
then
	echo "src_root_dir argument - $sroot_dir - must be a directory"
	print_usage
fi

mkdir -p $d_dir

mkdir -p $d_dir/out
mkdir -p $d_dir/build/

ls $sroot_dir/out/SRPMS/ >  $d_dir/out/ls_out_SRPMS.txt
ls $sroot_dir/out/RPMS/noarch/> $d_dir/out/ls_out_RPMS_noarch.txt
ls $sroot_dir/out/RPMS/x86_64/> $d_dir/out/ls_out_RPMS_x86_64.txt
tree out > $d_dir/out/tree_out.txt

cp -r $sroot_dir/build/pkg_artifacts/ $d_dir/build/

pushd $sroot_dir/build
tar -czf $sroot_dir/logs.tgz logs
popd

mv $sroot_dir/logs.tgz $d_dir/build/logs.tgz

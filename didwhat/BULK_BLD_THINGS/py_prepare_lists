def upd_lst_of_build_pkgs():
    global wkg_build_list_fl
    global pkglocinfo

    #print(func_nm_shrthnd() + f': Entered for package name {pkgnm}, new package name {pkgnewnm}, PR status = {pkgPRstatus}, package location {pkglocinfo}, download success = {pkgdnldsuccess}, working build list file = {WORKING_BUILD_LIST_FL}\n')

    #if ( pkgnm == 'OpenEXR' ):
        #print(func_nm_shrthnd() + f': Removing {pkgnm} from build list. Where package name {pkgnm}, new package name {pkgnewnm}, PR status = {pkgPRstatus}, package location {pkglocinfo}, download success = {pkgdnldsuccess}\n')
        #sh_scr_result=subprocess.run([f'{GENERAL_UTILS_DIR}/rem_full_line_match', f'{pkgnm}', f'{WORKING_BUILD_LIST_FL}'], stdout=subprocess.PIPE)
        #print(func_nm_shrthnd() + f': Replacing in build list. Where package name {pkgnm}, new package name {pkgnewnm}, PR status = {pkgPRstatus}, package location {pkglocinfo}, download success = {pkgdnldsuccess}\n')
        #sh_scr_result=subprocess.run([f'{GENERAL_UTILS_DIR}/rep_full_line_a_by_b', f'{pkgnm}', f'{pkgnewnm}', f'{WORKING_BUILD_LIST_FL}'], stdout=subprocess.PIPE)
    #return 0

    # if a package has been moved to the core and no PR has yet been 
    # merged for it then it must be removed from the build list
    if ( (pkglocinfo == 'MOVED_TO_CORE') and (pkgPRstatus != 'MERGED') ):
        #print(func_nm_shrthnd() + f': Removing from build list. Where package name {pkgnm}, new package name {pkgnewnm}, PR status = {pkgPRstatus}, package location {pkglocinfo}, download success = {pkgdnldsuccess}\n')
        sh_scr_result=subprocess.run([f'{GENERAL_UTILS_DIR}/rem_full_line_match', f'{pkgnm}', f'{WORKING_BUILD_LIST_FL}'], stdout=subprocess.PIPE)
    # if a package exists in both core and ext and no PR has yet been
    # merged for it then it must be removed from the build list
    elif ( (pkglocinfo == 'EXISTS_IN_BOTH') and (pkgPRstatus != 'MERGED') ):
        #print(func_nm_shrthnd() + f': Removing from build list. Where package name {pkgnm}, new package name {pkgnewnm}, PR status = {pkgPRstatus}, package location {pkglocinfo}, download success = {pkgdnldsuccess}\n')
        sh_scr_result=subprocess.run([f'{GENERAL_UTILS_DIR}/rem_full_line_match', f'{pkgnm}', f'{WORKING_BUILD_LIST_FL}'], stdout=subprocess.PIPE)
    # if package exists only in ext and has not been merged and the
    # there is a possibility of update to the build list.  Check for that.
    elif ( (pkglocinfo == 'EXISTS_IN_EXT') and (pkgPRstatus != 'MERGED') ):
        # if the package has been downloaded successfully and the name
        # has changed then the old name would be present in the build list.
        # There are three things possible with this old name in the build list:
        # 1. It is removed from the build list
        # 2. It is replaced by the new package name
        # 3. It is left as is in the build list
        # Note that 
        #       pkgnewnm as 'NA' means that the name has not changed
        #       Using pkddnldsuccess != 0 as a test for download success, because
        #       this value could be 1 or more than 1.  0 indicates no srpms downloaded.  
        #       non-zero would mean at least one srpm download was successful.
        if ( (pkgdnldsuccess != 0) and (pkgnewnm != 'NA') ):
            #print (func_nm_shrthnd() + f': The package {pkgnm} has a new name {pkgnewnm}')
            p = Path(f'{CODE_DIR}/SPECS')
            q = p/f'{pkgnewnm}'
            #
            # Scenario for the removal from the build list:
            # =============================================
            # If the package exists in the core (i.e. SPECS folder), with it's new name
            # it means that the package has been moved to the core.  This therefore
            # is the same as "MOVED_TO_CORE" case. Just that it was difficult to 
            # detect as its new name had been moved to the core
            # Therefore, we remove the package from build list.  It is present in 
            # the build list with its old name.  Remove that.
            # Note that this removal happens even when the package is not marked 
            # for upgrade.
            if (q.exists()):
                #print (func_nm_shrthnd() + f'{pkgnewnm} found in core')
                #print(func_nm_shrthnd() + f': Removing from build list. Where package name {pkgnm}, new package name {pkgnewnm}, PR status = {pkgPRstatus}, package location {pkglocinfo}, download success = {pkgdnldsuccess}')
                sh_scr_result=subprocess.run([f'{GENERAL_UTILS_DIR}/rem_full_line_match', f'{pkgnm}', f'{WORKING_BUILD_LIST_FL}'], stdout=subprocess.PIPE)
            #
            # Scenario for replacing the old name by the new:
            # ===============================================
            # The new name of the package is not there in the core.  It means that 
            # if the package needs to be upgraded then it is its new name and not
            # the old name that will be built.
            # In that case replace the old name by the new name in the build list.
            else:
                #print (func_nm_shrthnd() + f': {pkgnewnm} missing in core')
                if ( (pkgupgddecisionfinal == 'Y') or (pkgupgddecisionfinal == 'Revisit No Dnld Ver') or (pkgupgddecisionfinal == 'Revisit No Bld Ver') or (pkgupgddecisionfinal == 'Revisit Ver Compare')):
                    #print (func_nm_shrthnd() + f': {pkgnm}/{pkgnewnm} needs to be upgraded')
                    #print(func_nm_shrthnd() + f': Replacing in build list. Where package name {pkgnm}, new package name {pkgnewnm}, PR status = {pkgPRstatus}, package location {pkglocinfo}, download success = {pkgdnldsuccess}')
                    sh_scr_result=subprocess.run([f'{GENERAL_UTILS_DIR}/rep_full_line_a_by_b', f'{pkgnm}', f'{pkgnewnm}', f'{WORKING_BUILD_LIST_FL}'], stdout=subprocess.PIPE)
                    strres = sh_scr_result.stdout.decode('utf-8')
                    #print (func_nm_shrthnd() + f': result of {GENERAL_UTILS_DIR}/rep_full_line_a_by_b is \n{strres}')

    # General Note: a package that is a "NEW_ADDITION" will not go into either the remove list or copy list.
    # If the PR of this package has been merged then the corresponding directory will be there in SPECS-EXTENDED
    # In that case we will just build this package


    #SOME TESTING WHILE DEVELOPING THIS FUNCTION
    #sh_scr_result=subprocess.run([f'{GENERAL_UTILS_DIR}/rep_full_line_a_by_b', 'GeoIP-GeoLite-data', 'GEOIIIOOOIP-GEOLITE-DATA', f'{WORKING_BUILD_LIST_FL}'], stdout=subprocess.PIPE)
    #sh_scr_result=subprocess.run(['ls', '-ls', f'{GENERAL_UTILS_DIR}/rep_full_line_a_by_b', 'GeoIP-GeoLite-data', 'GEOIIIOOOIP-GEOLITE-DATA', f'{WORKING_BUILD_LIST_FL}'], stdout=subprocess.PIPE)
    #strres = sh_scr_result.stdout.decode('utf-8')
    #print (f'result of ls is \n{strres}')
    
    return 0


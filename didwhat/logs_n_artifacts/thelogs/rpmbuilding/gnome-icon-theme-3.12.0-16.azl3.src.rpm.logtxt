time="2025-03-07T10:25:09Z" level=debug msg="\t\t/usr/bin/mkdir -p /usr/src/azl/BUILDROOT/gnome-icon-theme-3.12.0-16.azl3.x86_64/usr/share/icons/gnome/$size/$context; \\"
time="2025-03-07T10:25:09Z" level=debug msg="\t\t/bin/sh /usr/src/azl/BUILD/gnome-icon-theme-3.12.0/install-sh -c -m 644 ../gnome/$size/$file /usr/src/azl/BUILDROOT/gnome-icon-theme-3.12.0-16.azl3.x86_64/usr/share/icons/gnome/$size/$file; \\"

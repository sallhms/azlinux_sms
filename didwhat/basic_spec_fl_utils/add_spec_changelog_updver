#Store the version number in a variable so that the changelog comment can have that info
pkgvr=`echo $pdet_line | awk 'BEGIN {FS = ","} {print $2}'`
if [ -z "$pkgvr" ]
then
	pkgvr=`rpmspec -q --qf  "%{version}\n" $spcfl 2>/dev/null | head -1`
else
	echo "The environment variable pkgvr is empty"
fi

#only for debugging
#echo $pkgvr

LINE2_OF_CHANGELOG="- Update to version $pkgvr"

#You can comment the earlier definition of LINE2_OF_CHANGELOG and use this one 
#echo $dt_part

TEMP_SPEC=$(mktemp /tmp/tempsp-XXXXXXX)	

#awk -v version_var="$pkgvr" -v dt_var="$dt_part" -v auth_var="$author_part" -v rel_var="$rel_numerical_part" -v line2_chlog="$LINE2_OF_CHANGELOG"  '
awk -v version_var="$pkgvr" -v dt_var="$dt_part" -v auth_nm="$author_name" -v auth_eml="$author_email" -v rel_var="$rel_numerical_part" -v line2_chlog="$LINE2_OF_CHANGELOG" -v line3_chlog="$LINE3_OF_CHANGELOG"  '
/^%changelog/ {
	print ($0)
	printf ("* %s %s %s - %s-%s\n", dt_var, auth_nm, auth_eml, version_var, rel_var)
	printf ("%s\n", line2_chlog) 
	printf ("\n")
}
!/^%changelog/ {
	print ($0)
}
'  $spcfl > $TEMP_SPEC

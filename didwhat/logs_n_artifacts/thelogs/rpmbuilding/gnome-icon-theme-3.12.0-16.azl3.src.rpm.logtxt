time="2025-03-07T10:25:09Z" level=debug msg="\t\t\tcontext=\"`echo $dir | cut -c 3-`\"; \\"
time="2025-03-07T10:25:09Z" level=debug msg="\t\t\tif [ $context ]; then \\"
time="2025-03-07T10:25:09Z" level=debug msg="\t\t\t\t/usr/bin/icon-name-mapping -c $context; \\"

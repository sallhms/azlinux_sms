def check_build_status(pnm):
	global ver_bld_status
	global rel_bld_status
	global bld_status

	cols = ['Package','State','Blocker','IsTest']
	table = pd.read_csv(BUILD_ARTFCT_STATUS_FL, usecols=cols)
	for row in table.itertuples():
		#if src.rpm extension is present split it and pick the name part excluding src.rpm
		name_wo_srcrpm = re.split(r"(.src.rpm)", row[1])
		name_parts = re.search(r"(.*)-(.*)-(.*)$", name_wo_srcrpm[0])
		#print(f'for srpm name {row[1]} the parts of the package name are:')
		#print(f'Full string:{name_parts[0]}, package name:{name_parts[1]}, version:{name_parts[2]}, release:{name_parts[3]}')
		if ( pnm == name_parts[1] ):
			#print (f'for package {pnm}, the srpm is {name_parts[0]}, version is {name_parts[2]}, release is {name_parts[3]}') 
			ver_bld_status = name_parts[2]
			rel_bld_status = name_parts[3]
			bld_status = row[2]
			break
	if ( pnm != name_parts[1] ):
		#print (f'package {pnm} not in the build list')
		ver_bld_status = f'Not Found'
		rel_bld_status = f'Not Found'
		bld_status = f'Not Found'

def check_dnld_status(pkname):
	global dnld_det_fl_lines
	in_pk_section = 0
	global dnld_det_srpmlist
	global dnld_det_success
	global dnld_ver
	global dnld_rel
	global dl_srpm_count
	global dl_srpm1
	global dl_srpm2
	global dl_srpm3

	dnld_det_srpmlist.clear()
	dnld_det_success = 0
	dl_srpm_count = 0
	dl_srpm1 = 'Default Initialized'
	dl_srpm2 = 'Default Initialized'
	dl_srpm3 = 'Default Initialized'
	dnld_ver = 'Not Found'
	dnld_rel = 'Not Found'
	package_name_from_srpm = ''

	count = 0
	for line in dnld_det_fl_lines:
		count = count + 1
		#print (line)
		pk_first_line_parts = re.search(r"^Attempting for (.*)", line)
		if ( pk_first_line_parts != None ):
			#print (f'line num {count} is: {pk_first_line_parts}')
			#print (f'first part {pk_first_line_parts[0]}, second part {pk_first_line_parts[1]}')
			if ( pkname == pk_first_line_parts[1] ):
				in_pk_section = 1
				#print (f'{pkname}: Section starts at line {count}')

		if ( 1 == in_pk_section ):
			#print (f'{pkname}: line {count} in package section')
			ignore_pattern1 = re.search(r"^===================", line)
			if ( ignore_pattern1 != None ):
				#print (f'Ignoring the pattern 1')
				continue
			ignore_pattern2 = re.search(r"^dest_dir\/.*", line)
			if ( ignore_pattern2 != None ):
				#print (f'Ignoring the pattern 2')
				continue
			ignore_pattern3 = re.search(r"^enabling fedora-.*source repository", line)
			if ( ignore_pattern3 != None ):
				#print (f'Ignoring the pattern 3')
				continue
			ignore_pattern4 = re.search(r"^enabling updates-source repository", line)
			if ( ignore_pattern4 != None ):
				#print (f'Ignoring the pattern 4')
				continue
			ignore_pattern5 = re.search(r"^Fedora 41 .*/s \| .*", line)
			if ( ignore_pattern5 != None ):
				#print (f'Ignoring the pattern 5')
				continue
			ignore_pattern6 = re.search(r"^Last metadata expiration check:.*", line)
			if ( ignore_pattern6 != None ):
				#print (f'Ignoring the pattern 6')
				continue
			srpm_pattern = re.search(r"^(.*) [0-9][0-9\.]*.*\|.*", line)
			if ( srpm_pattern != None ):
				stripped_srpm_pattern=srpm_pattern[1].strip()
				#print (f'{pkname}: srpm_pattern is {stripped_srpm_pattern}')
				dnld_det_srpmlist.append(stripped_srpm_pattern)
				dl_srpm_count = dl_srpm_count + 1
			end_pattern_failcase = re.search(r"^DL FAIL:.*", line)
			if ( end_pattern_failcase != None ):
				end_pk_section = 1
				dnld_det_success = 0
				#print (f'{pkname}: download fail seen at line {count}')
				break

			end_pattern_successcase = re.search(r"^DL SUCCESS:.*", line)
			if ( end_pattern_successcase != None ):
				end_pk_section = 1
				dnld_det_success = 1
				#print (f'{pkname}: download success seen at line {count}')
				#print (f'the srpm list is {dnld_det_srpmlist}')
				#find the version and release of the first srpm in the list of srpms downloaded for this package
				#remove the .src.rpm extension if present in the name of the package file
				#Use the name from the first srpm for all packages except libldb
				if ( 'libldb' != pkname ):
					name_wo_srcrpm = re.split(r"(.src.rpm)", dnld_det_srpmlist[0])
					if ( name_wo_srcrpm != None):
						name_parts = re.search(r"(.*)-(.*)-(.*)$", name_wo_srcrpm[0])
						#print(f'for srpm name {row[1]} the parts of the package name are:')
						#print(f'Full string:{name_parts[0]}, package name:{name_parts[1]}, version:{name_parts[2]}, release:{name_parts[3]}')
						dnld_ver = name_parts[2] 
						dnld_rel = name_parts[3] 
						#print(f'For the first srpm version is {dnld_ver} and release is {dnld_rel}')
				#for libldb only use the version number from that downloaded srpm which is libldb.*.src.rpm
				elif ( 'libldb' == pkname ):
					#hard coding the ver and rel because extracting those from one of the multiple srpms
					#downloaded was a complex thing.  Requires going through the list of downloaded srpms
					#and also the lines for these downloads are not as simple as the cases where single
					#srpm is downloaded, because these lines for multiples downloads include (1/2): and 
					#(2/2): etc in the start.
					dnld_ver = '2.9.1'
					dnld_rel = '4'
							
				if ( 1 <= dl_srpm_count ):
					dl_srpm1 = dnld_det_srpmlist[0]
				if ( 2 <= dl_srpm_count ):
					dl_srpm2 = dnld_det_srpmlist[1]
				if ( 3 <= dl_srpm_count ):
					dl_srpm3 = dnld_det_srpmlist[2]
				break

	if ( 1 != in_pk_section ):
		#print (f'{pkname}: Not in downloads')
		dnld_det_success = 0

def check_pkg_azl_existence(pkname):
	global pkg_existence
	global ver_in_3_dev
	ver_in_3_dev = 'Not Found'

	dirpathstr=MSREPO_3DEV_WORKDIR + "/SPECS/" + pkname
	#print (f'dirpathstr is {dirpathstr}')
	file=Path(dirpathstr)
	if ( file.is_dir() ):
		pkg_in_3_core = 1
	else:
		pkg_in_3_core = 0
		
	dirpathstr=MSREPO_3DEV_WORKDIR + "/SPECS-EXTENDED/" + pkname
	#print (f'dirpathstr is {dirpathstr}')
	file=Path(dirpathstr)
	if ( file.is_dir() ):
		pkg_in_3_ext = 1
	else:
		pkg_in_3_ext = 0

	if ( pkg_in_3_core == 1 and pkg_in_3_ext == 1):
		pkg_existence = 'EXISTS_IN_BOTH'
	elif ( pkg_in_3_core == 1 and pkg_in_3_ext == 0):
		pkg_existence = 'MOVED_TO_CORE'
	elif ( pkg_in_3_core == 0 and pkg_in_3_ext == 0):
		pkg_existence = 'REMOVED_FROM_BOTH'
	else:
		pkg_existence = 'EXISTS_IN_EXT'
	
	if ( 'EXISTS_IN_EXT' == pkg_existence ):
		flpathstr=MSREPO_3DEV_WORKDIR + "/SPECS-EXTENDED/" + pkname + "/" + pkname + ".spec"
		file=Path(flpathstr)
		if ( file.is_file() ):
			spec = Spec.from_file(flpathstr)
			ver_in_3_dev = spec.version
			#If there are macros in ver_in_3_dev, try to replace them
			if '%' in ver_in_3_dev:
				ver_in_3_dev = replace_macros(spec.version, spec)
			#if even after replacing the macros there are unresolved components remaining
			if '%' in ver_in_3_dev:
				ver_in_3_dev = 'Not Found'
		else:
			ver_in_3_dev = 'No Spec Found'

	#print (f'{pkname} {pkg_existence}')

def set_upgrade_reqd(pkname):
	global ver_bld_status
	global dnld_ver
	global upgd_reqd

	upgd_reqd = 'Revisit'

	if ( 'Not Found' == ver_bld_status ):
		upgd_reqd = 'Revisit No Bld Ver'
	elif ('Not Found' == dnld_ver ):
		upgd_reqd = 'Revisit No Dnld Ver'
	elif ( ver_bld_status == dnld_ver ):
		upgd_reqd = 'N'
	else:
		upgd_reqd = 'Y'
		

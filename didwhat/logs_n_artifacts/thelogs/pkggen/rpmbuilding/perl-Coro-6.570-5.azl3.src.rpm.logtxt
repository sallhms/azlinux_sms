time="2025-03-12T08:23:53Z" level=debug msg="Executing(%build): /bin/sh -e /var/tmp/rpm-tmp.ICAUhZ"
time="2025-03-12T08:23:53Z" level=debug msg="++ jobs -p"
time="2025-03-12T08:23:53Z" level=debug msg="+ exit 0"
time="2025-03-12T08:23:53Z" level=debug msg="+ umask 022"
time="2025-03-12T08:23:53Z" level=debug msg="+ cd /usr/src/azl/BUILD"
time="2025-03-12T08:23:53Z" level=debug msg="+ CFLAGS='-O2 -g -pipe -Wall -Werror=format-security -Wp,-D_FORTIFY_SOURCE=2 -Wp,-D_GLIBCXX_ASSERTIONS -fexceptions -fstack-protector-strong -grecord-gcc-switches -specs=/usr/lib/rpm/azl/default-hardened-cc1    -fcommon -m64 -mtune=generic -fasynchronous-unwind-tables -fstack-clash-protection -fcf-protection'"
time="2025-03-12T08:23:53Z" level=debug msg="+ export CFLAGS"
time="2025-03-12T08:23:53Z" level=debug msg="+ CXXFLAGS='-O2 -g -pipe -Wall -Werror=format-security -Wp,-D_FORTIFY_SOURCE=2 -Wp,-D_GLIBCXX_ASSERTIONS -fexceptions -fstack-protector-strong -grecord-gcc-switches -specs=/usr/lib/rpm/azl/default-hardened-cc1    -fcommon -m64 -mtune=generic -fasynchronous-unwind-tables -fstack-clash-protection -fcf-protection'"
time="2025-03-12T08:23:53Z" level=debug msg="+ export CXXFLAGS"
time="2025-03-12T08:23:53Z" level=debug msg="+ FFLAGS='-O2 -g -pipe -Wall -Werror=format-security -Wp,-D_FORTIFY_SOURCE=2 -Wp,-D_GLIBCXX_ASSERTIONS -fexceptions -fstack-protector-strong -grecord-gcc-switches -specs=/usr/lib/rpm/azl/default-hardened-cc1    -fcommon -m64 -mtune=generic -fasynchronous-unwind-tables -fstack-clash-protection -fcf-protection -I/usr/lib/gfortran/modules'"
time="2025-03-12T08:23:53Z" level=debug msg="+ export FFLAGS"
time="2025-03-12T08:23:53Z" level=debug msg="+ FCFLAGS='-O2 -g -pipe -Wall -Werror=format-security -Wp,-D_FORTIFY_SOURCE=2 -Wp,-D_GLIBCXX_ASSERTIONS -fexceptions -fstack-protector-strong -grecord-gcc-switches -specs=/usr/lib/rpm/azl/default-hardened-cc1    -fcommon -m64 -mtune=generic -fasynchronous-unwind-tables -fstack-clash-protection -fcf-protection -I/usr/lib/gfortran/modules'"
time="2025-03-12T08:23:53Z" level=debug msg="+ export FCFLAGS"
time="2025-03-12T08:23:53Z" level=debug msg="+ LDFLAGS='-Wl,-z,relro -Wl,--as-needed  -Wl,-z,now -specs=/usr/lib/rpm/azl/default-hardened-ld -Wl,-dT,/usr/src/azl/BUILD/module_info.ld'"
time="2025-03-12T08:23:53Z" level=debug msg="+ export LDFLAGS"
time="2025-03-12T08:23:53Z" level=debug msg="+ LT_SYS_LIBRARY_PATH=/usr/lib:"
time="2025-03-12T08:23:53Z" level=debug msg="+ export LT_SYS_LIBRARY_PATH"
time="2025-03-12T08:23:53Z" level=debug msg="+ PATH=/usr/lib/ccache:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
time="2025-03-12T08:23:53Z" level=debug msg="+ export PATH"
time="2025-03-12T08:23:53Z" level=debug msg="+ CCACHE_DIR=/ccache-dir"
time="2025-03-12T08:23:53Z" level=debug msg="+ export CCACHE_DIR"
time="2025-03-12T08:23:53Z" level=debug msg="+ CCACHE_COMPILERCHECK=content"
time="2025-03-12T08:23:53Z" level=debug msg="+ export CCACHE_COMPILERCHECK"
time="2025-03-12T08:23:53Z" level=debug msg="+ ccache --zero-stats"
time="2025-03-12T08:23:53Z" level=debug msg="Statistics zeroed"
time="2025-03-12T08:23:53Z" level=debug msg="+ cd Coro-6.57"
time="2025-03-12T08:23:53Z" level=debug msg="+ perl Makefile.PL INSTALLDIRS=perl NO_PACKLIST=1 NO_PERLLOCAL=1 'OPTIMIZE=-O2 -g -pipe -Wall -Werror=format-security -Wp,-D_FORTIFY_SOURCE=2 -Wp,-D_GLIBCXX_ASSERTIONS -fexceptions -fstack-protector-strong -grecord-gcc-switches -specs=/usr/lib/rpm/azl/default-hardened-cc1    -fcommon -m64 -mtune=generic -fasynchronous-unwind-tables -fstack-clash-protection -fcf-protection'"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="***"
time="2025-03-12T08:23:54Z" level=debug msg="*** Canary::Stability COMPATIBILITY AND SUPPORT CHECK"
time="2025-03-12T08:23:54Z" level=debug msg="*** ================================================="
time="2025-03-12T08:23:54Z" level=debug msg="***"
time="2025-03-12T08:23:54Z" level=debug msg="*** Hi!"
time="2025-03-12T08:23:54Z" level=debug msg="***"
time="2025-03-12T08:23:54Z" level=debug msg="*** I do my best to provide predictable and reliable software."
time="2025-03-12T08:23:54Z" level=debug msg="***"
time="2025-03-12T08:23:54Z" level=debug msg="*** However, in recent releases, P5P (who maintain perl) have been"
time="2025-03-12T08:23:54Z" level=debug msg="*** introducing regressions that are sometimes subtle and at other times"
time="2025-03-12T08:23:54Z" level=debug msg="*** catastrophic, often for personal preferences with little or no concern"
time="2025-03-12T08:23:54Z" level=debug msg="*** for existing code, most notably CPAN."
time="2025-03-12T08:23:54Z" level=debug msg="***"
time="2025-03-12T08:23:54Z" level=debug msg="*** For this reason, it has become very hard for me to maintain the level"
time="2025-03-12T08:23:54Z" level=debug msg="*** of reliability and support I have committed myself to in the past, at"
time="2025-03-12T08:23:54Z" level=debug msg="*** least with some perl versions: I simply can't keep up working around new"
time="2025-03-12T08:23:54Z" level=debug msg="*** bugs or gratituous incompatibilities, and in turn you might suffer from"
time="2025-03-12T08:23:54Z" level=debug msg="*** unanticipated problems."
time="2025-03-12T08:23:54Z" level=debug msg="***"
time="2025-03-12T08:23:54Z" level=debug msg="*** Therefore I have introduced a support and compatibility check, the results"
time="2025-03-12T08:23:54Z" level=debug msg="*** of which follow below, together with a FAQ and some recommendations."
time="2025-03-12T08:23:54Z" level=debug msg="***"
time="2025-03-12T08:23:54Z" level=debug msg="*** This check is just to let you know that there might be a risk, so you can"
time="2025-03-12T08:23:54Z" level=debug msg="*** make judgement calls on how to proceed - it will not keep the module from"
time="2025-03-12T08:23:54Z" level=debug msg="*** installing or working."
time="2025-03-12T08:23:54Z" level=debug msg="***"
time="2025-03-12T08:23:54Z" level=debug msg="*** The stability canary says: (nothing, it was driven away by harsh weather)"
time="2025-03-12T08:23:54Z" level=debug msg="***"
time="2025-03-12T08:23:54Z" level=debug msg="*** It seems you are running perl version 5.038002, likely the \"official\" or"
time="2025-03-12T08:23:54Z" level=debug msg="*** \"standard\" version. While there is nothing wrong with doing that,"
time="2025-03-12T08:23:54Z" level=debug msg="*** standard perl versions 5.022 and up are not supported by Coro."
time="2025-03-12T08:23:54Z" level=debug msg="*** While this might be fatal, it might also be all right - if you run into"
time="2025-03-12T08:23:54Z" level=debug msg="*** problems, you might want to downgrade your perl or switch to the"
time="2025-03-12T08:23:54Z" level=debug msg="*** stability branch."
time="2025-03-12T08:23:54Z" level=debug msg="***"
time="2025-03-12T08:23:54Z" level=debug msg="*** If everything works fine, you can ignore this message."
time="2025-03-12T08:23:54Z" level=debug msg="***"
time="2025-03-12T08:23:54Z" level=debug msg="***"
time="2025-03-12T08:23:54Z" level=debug msg="*** Stability canary mini-FAQ:"
time="2025-03-12T08:23:54Z" level=debug msg="***"
time="2025-03-12T08:23:54Z" level=debug msg="*** Do I need to do anything?"
time="2025-03-12T08:23:54Z" level=debug msg="***    With luck, no. While some distributions are known to fail"
time="2025-03-12T08:23:54Z" level=debug msg="***    already, most should probably work. This message is here"
time="2025-03-12T08:23:54Z" level=debug msg="***    to alert you that your perl is not supported by Coro,"
time="2025-03-12T08:23:54Z" level=debug msg="***    and if things go wrong, you either need to downgrade, or"
time="2025-03-12T08:23:54Z" level=debug msg="***    sidegrade to the stability variant of your perl version,"
time="2025-03-12T08:23:54Z" level=debug msg="***    or simply live with the consequences."
time="2025-03-12T08:23:54Z" level=debug msg="***"
time="2025-03-12T08:23:54Z" level=debug msg="*** What is this canary thing?"
time="2025-03-12T08:23:54Z" level=debug msg="***    It's purpose is to check support status of Coro with"
time="2025-03-12T08:23:54Z" level=debug msg="***    respect to your perl version."
time="2025-03-12T08:23:54Z" level=debug msg="***"
time="2025-03-12T08:23:54Z" level=debug msg="*** What is this \"stability branch\"?"
time="2025-03-12T08:23:54Z" level=debug msg="***    It's a branch or fork of the official perl, by schmorp, to"
time="2025-03-12T08:23:54Z" level=debug msg="***    improve stability and compatibility with existing modules."
time="2025-03-12T08:23:54Z" level=debug msg="***"
time="2025-03-12T08:23:54Z" level=debug msg="*** How can I skip this prompt on automated installs?"
time="2025-03-12T08:23:54Z" level=debug msg="***    Set PERL_CANARY_STABILITY_NOPROMPT=1 in your environment."
time="2025-03-12T08:23:54Z" level=debug msg="***    More info is in the Canary::Stability manpage."
time="2025-03-12T08:23:54Z" level=debug msg="***"
time="2025-03-12T08:23:54Z" level=debug msg="*** Long version of this FAQ: http://stableperl.schmorp.de/faq.html"
time="2025-03-12T08:23:54Z" level=debug msg="*** Stability Branch homepage: http://stableperl.schmorp.de/"
time="2025-03-12T08:23:54Z" level=debug msg="***"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Continue anyways?  [y] y"
time="2025-03-12T08:23:54Z" level=debug msg="*** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** ***"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Event version 1.28 found, building Event support."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="EV version 4.34 found, building EV support."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Checking if your kit is complete..."
time="2025-03-12T08:23:54Z" level=debug msg="Looks good"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="*** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** ***"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Coro has a number of configuration options. Due to its maturity, the"
time="2025-03-12T08:23:54Z" level=debug msg="defaults that Coro chooses are usually fine, so you can decide to skip"
time="2025-03-12T08:23:54Z" level=debug msg="these questions. Only if something went wrong you should select 'n'"
time="2025-03-12T08:23:54Z" level=debug msg="here and manually configure Coro, and, of course, report this to the"
time="2025-03-12T08:23:54Z" level=debug msg="maintainer :)"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Skip further questions and use defaults (y/n)? [y] y"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="*** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** ***"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Coro can use a number of methods to implement coroutines at the C"
time="2025-03-12T08:23:54Z" level=debug msg="level. The default chosen is based on your current confguration and is"
time="2025-03-12T08:23:54Z" level=debug msg="correct in most cases, but you still can chose between these alternatives:"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="u  The unix 'ucontext.h' functions are relatively new and not implemented"
time="2025-03-12T08:23:54Z" level=debug msg="   or well-tested in older unices. They allow very fast coroutine creation"
time="2025-03-12T08:23:54Z" level=debug msg="   and reasonably fast switching. They are, however, usually slower than"
time="2025-03-12T08:23:54Z" level=debug msg="   the other alternatives due to an extra syscall done by swapcontext. And"
time="2025-03-12T08:23:54Z" level=debug msg="   while nominally most portable (it's the only POSIX-standardised"
time="2025-03-12T08:23:54Z" level=debug msg="   interface for coroutines), ucontext functions are, as usual, broken on"
time="2025-03-12T08:23:54Z" level=debug msg="   most/all BSDs."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="s  If the ucontext functions are not working or you don't want"
time="2025-03-12T08:23:54Z" level=debug msg="   to use them for other reasons you can try a workaround using"
time="2025-03-12T08:23:54Z" level=debug msg="   setjmp/longjmp/sigaltstack (also standard unix functions). Coroutine"
time="2025-03-12T08:23:54Z" level=debug msg="   creation is rather slow, but switching is very fast (often much faster"
time="2025-03-12T08:23:54Z" level=debug msg="   than with the ucontext functions). Unfortunately, glibc-2.1 and"
time="2025-03-12T08:23:54Z" level=debug msg="   below don't even feature a working sigaltstack. You cannot use this"
time="2025-03-12T08:23:54Z" level=debug msg="   implementation if some other code uses SIGUSR2 or you plan to create"
time="2025-03-12T08:23:54Z" level=debug msg="   coroutines from an alternative signal stack, as both are being used for"
time="2025-03-12T08:23:54Z" level=debug msg="   coroutine creation."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="a  Handcoded assembly. This is the fastest and most compatible method,"
time="2025-03-12T08:23:54Z" level=debug msg="   with the least side effects, if it works, that is. It has been tested"
time="2025-03-12T08:23:54Z" level=debug msg="   on GNU/Linux x86 and x86_64 systems and should work on all x86/x86_64"
time="2025-03-12T08:23:54Z" level=debug msg="   systems using the SVR ELF ABI (it is also reported to be working on"
time="2025-03-12T08:23:54Z" level=debug msg="   Strawberry Perl for Windows using MinGW). This is the recommended"
time="2025-03-12T08:23:54Z" level=debug msg="   method on supported platforms. When it doesn't work, use another"
time="2025-03-12T08:23:54Z" level=debug msg="   method, such as (s)etjmp/longjmp."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="l  GNU/Linux. Very old GNU/Linux systems (glibc-2.1 and below) need"
time="2025-03-12T08:23:54Z" level=debug msg="   this hack. Since it is very linux-specific it is also quite fast and"
time="2025-03-12T08:23:54Z" level=debug msg="   recommended even for newer versions; when it works, that is (currently"
time="2025-03-12T08:23:54Z" level=debug msg="   x86 and a few others only. If it compiles, it's usually ok). Newer"
time="2025-03-12T08:23:54Z" level=debug msg="   glibc versions (>= 2.5) stop working with this implementation however."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="i  IRIX. For some reason, SGI really does not like to follow POSIX (does"
time="2025-03-12T08:23:54Z" level=debug msg="   that surprise you?), so this workaround might be needed (it's fast),"
time="2025-03-12T08:23:54Z" level=debug msg="   although [s] and [u] should also work now."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="w  Microsoft Windows. Try this on Microsoft Windows when using Cygwin or"
time="2025-03-12T08:23:54Z" level=debug msg="   the MSVC compilers (e.g. ActiveState Perl, but see \"a\" for Strawberry"
time="2025-03-12T08:23:54Z" level=debug msg="   Perl), although, as there is no standard on how to do this under"
time="2025-03-12T08:23:54Z" level=debug msg="   windows, different environments might work differently. Doh."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="f  Microsoft Windows. Try this on Microsoft Windows if w fails. It is slower"
time="2025-03-12T08:23:54Z" level=debug msg="   and uses a lot more memory, but should be working all the time."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="p  Use pthread API. Try to avoid this option, it was only created to"
time="2025-03-12T08:23:54Z" level=debug msg="   make a point about the programming language shootout. It is unlikely"
time="2025-03-12T08:23:54Z" level=debug msg="   to work with perls that have windows process emulation enabled (\"perl"
time="2025-03-12T08:23:54Z" level=debug msg="   threads\"). It is also likely the slowest method of implementing"
time="2025-03-12T08:23:54Z" level=debug msg="   coroutines. It might work fine as a last resort, however, as the"
time="2025-03-12T08:23:54Z" level=debug msg="   pthread API is slightly better tested than ucontext functions for"
time="2025-03-12T08:23:54Z" level=debug msg="   example. Of course, not on BSDs, who usually have very broken pthread"
time="2025-03-12T08:23:54Z" level=debug msg="   implementations."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Coro tries hard to come up with a suitable default for most systems,"
time="2025-03-12T08:23:54Z" level=debug msg="so pressing return at the prompt usually does the right thing. If you"
time="2025-03-12T08:23:54Z" level=debug msg="experience problems (e.g. make test fails) then you should experiment with"
time="2025-03-12T08:23:54Z" level=debug msg="this setting."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Use which implementation,"
time="2025-03-12T08:23:54Z" level=debug msg="<s>etjmp, <u>ctx, <a>sm, <i>rix, <l>inux, <p>threads, <w>indows, <f>iber? [a] a"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Using handcoded assembler implementation"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="*** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** ***"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Per-context stack size factor: Depending on your settings, Coro tries to"
time="2025-03-12T08:23:54Z" level=debug msg="share the C stacks is creates as much as possible, but sometimes it needs"
time="2025-03-12T08:23:54Z" level=debug msg="to allocate a new one. This setting controls the maximum size that gets"
time="2025-03-12T08:23:54Z" level=debug msg="allocated, and should not be set too high, as memory and address space"
time="2025-03-12T08:23:54Z" level=debug msg="still is wasted even if it's not fully used. The value entered will be"
time="2025-03-12T08:23:54Z" level=debug msg="multiplied by sizeof(void *), which is usually 4 on 32-bit systems, and 8"
time="2025-03-12T08:23:54Z" level=debug msg="on 64-bit systems."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="A setting of 16384 (the default) therefore corresponds to a 64k..128k"
time="2025-03-12T08:23:54Z" level=debug msg="stack, which usually is ample space (you might even want to try 8192 or"
time="2025-03-12T08:23:54Z" level=debug msg="lower if your program creates many coroutines)."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="On systems supporting mmap and dynamic memory management, the actual"
time="2025-03-12T08:23:54Z" level=debug msg="memory usually gets allocated on demand, but with many large stacks you"
time="2025-03-12T08:23:54Z" level=debug msg="can still run out of address space on your typical 32 bit platform (not to"
time="2025-03-12T08:23:54Z" level=debug msg="forget the pagetables)."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Some perls (mostly threaded ones and perl compiled under linux 2.6) and"
time="2025-03-12T08:23:54Z" level=debug msg="some programs (inefficient regexes can use a lot of stack space) may"
time="2025-03-12T08:23:54Z" level=debug msg="need much, much more: If Coro segfaults with weird backtraces (e.g. in a"
time="2025-03-12T08:23:54Z" level=debug msg="function prologue) or in t/10_bugs.t, you might want to increase this to"
time="2025-03-12T08:23:54Z" level=debug msg="65536 or more."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="The default should be fine, and can be changed at runtime with"
time="2025-03-12T08:23:54Z" level=debug msg="Coro::State::cctx_stacksize."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="C stack size factor? [16384] 16384"
time="2025-03-12T08:23:54Z" level=debug msg="using a stacksize of 16384 * sizeof(void*)"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="*** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** ***"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Coro can optionally put a guard area before each stack segment: When the"
time="2025-03-12T08:23:54Z" level=debug msg="stack is too small and the access is not too far outside the stack (i.e."
time="2025-03-12T08:23:54Z" level=debug msg="within the guard area), then the program will safely segfault instead of"
time="2025-03-12T08:23:54Z" level=debug msg="running into other data. The cost is some additional overhead with is"
time="2025-03-12T08:23:54Z" level=debug msg="usually negligible, and extra use of address space."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="The guard area size currently needs to be specified in pages (typical"
time="2025-03-12T08:23:54Z" level=debug msg="pagesizes are 4k and 8k). The guard area is only enabled on a few"
time="2025-03-12T08:23:54Z" level=debug msg="hardcoded architectures and is ignored on others. The actual preprocessor"
time="2025-03-12T08:23:54Z" level=debug msg="expression disables this feature if:"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="   !__i386 && !__x86_64 && !__powerpc && !__m68k "
time="2025-03-12T08:23:54Z" level=debug msg="   && !__alpha && !__mips && !__sparc64"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="The default, as usual, should be just fine."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Number of guard pages (0 disables)? [4] 4"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="*** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** ***"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Coro can tell valgrind about its stacks and so reduce spurious warnings"
time="2025-03-12T08:23:54Z" level=debug msg="where valgrind would otherwise complain about possible stack switches."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Enabling this does not incur noticable runtime or memory overhead, but it"
time="2025-03-12T08:23:54Z" level=debug msg="requires that you have the <valgrind/valgrind.h> header file available."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Valgrind support is completely optional, so disabling it is the safe"
time="2025-03-12T08:23:54Z" level=debug msg=choice.
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Enable valgrind support (y/n)? [n] n"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="*** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** ***"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Coro can use (or even trick) some perl functions into doing what it needs"
time="2025-03-12T08:23:54Z" level=debug msg="instead of relying on (some) of its own functions. This might increase"
time="2025-03-12T08:23:54Z" level=debug msg="chances that it compiles and works, but it could just as well result in"
time="2025-03-12T08:23:54Z" level=debug msg="memory leaks, crashes or silent data corruption. It certainly does result"
time="2025-03-12T08:23:54Z" level=debug msg="in slightly slower speed and higher memory consumption, though, so YOU"
time="2025-03-12T08:23:54Z" level=debug msg="SHOULD ENABLE THIS OPTION ONLY AS A LAST RESORT."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Prefer perl functions over coro functions (y/n)? [n] n"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="*** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** ***"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Coro can use a simple JIT compiler to compile a part of the thread switch"
time="2025-03-12T08:23:54Z" level=debug msg="function at runtime. On perls with windows process emulation (most!),"
time="2025-03-12T08:23:54Z" level=debug msg="this results in a 50% speed improvement. On sane perls, the gain is much"
time="2025-03-12T08:23:54Z" level=debug msg="less, usually around 5%. If you enable this option, then the JIT will"
time="2025-03-12T08:23:54Z" level=debug msg="be enabled, on compatible operating systems and CPUs (currently only"
time="2025-03-12T08:23:54Z" level=debug msg="x86/amd64 on certain unix clones). Otherwise, it will be disabled. It"
time="2025-03-12T08:23:54Z" level=debug msg="should be safe to leave on - this setting is only here so you can switch"
time="2025-03-12T08:23:54Z" level=debug msg="it off in case of problems."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Note that some broken kernels (often calling themselves \"hardened\") break"
time="2025-03-12T08:23:54Z" level=debug msg="all JIT generation by manipulating some system calls. If you get bus"
time="2025-03-12T08:23:54Z" level=debug msg="errors or segmentation faults immediately when the JIT is enabled but not"
time="2025-03-12T08:23:54Z" level=debug msg="without, then note that disabling the JIT only fixes some symptoms, not"
time="2025-03-12T08:23:54Z" level=debug msg="the underlying problem, and you might run into other problems later."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Try to use the JIT compiler, if available? [y] y"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="*** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** ***"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Coro has experimental support for cloning states. This can be used"
time="2025-03-12T08:23:54Z" level=debug msg="to implement a scheme-like call/cc. However, this doesn't add to the"
time="2025-03-12T08:23:54Z" level=debug msg="expressiveness in general, and is likely perl-version specific (and perl"
time="2025-03-12T08:23:54Z" level=debug msg="5.12 deliberately removed support for it). As such, it is disabled by"
time="2025-03-12T08:23:54Z" level=debug msg="default.  Enable it when you want to play around with it, but note that it"
time="2025-03-12T08:23:54Z" level=debug msg="isn't supported, and unlikely ever will be. It exists mainly to prove that"
time="2025-03-12T08:23:54Z" level=debug msg="it could be done - if only it were useful for something."
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="Implement Coro::State->clone method (y/n)? [n] n"
time="2025-03-12T08:23:54Z" level=debug
time="2025-03-12T08:23:54Z" level=debug msg="*** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** *** ***"
time="2025-03-12T08:23:54Z" level=debug

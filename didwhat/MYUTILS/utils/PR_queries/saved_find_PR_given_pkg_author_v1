

AUTH=$1
PKGNM=$2

gh pr list -L 100 --author "$AUTH" -S "is:open $PKGNM in:title NOT in:title CVE"
if [ $? ne 0 ]
then
gh pr list -L 100 --author "$AUTH" -S "is:merged $PKGNM in:title NOT in:title CVE"
fi






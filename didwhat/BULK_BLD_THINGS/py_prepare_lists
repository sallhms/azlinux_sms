def upd_lst_of_rem_folders():
    global rem_list_fl
    global pkglocinfo
    
    #print(func_nm_shrthnd() + f': Entered for package name {pkgnm}, PR status = {pkgPRstatus}, Final upgd decision = {pkgupgddecisionfinal}, package location {pkglocinfo}, download success = {pkgdnldsuccess}\n')

    # If a package has been moved to the core and no PR has yet been 
    # merged for it then it must be removed from the extended folder.
    # Therefore add it to the remove list of folders
    if ( (pkgPRstatus != 'MERGED') and (pkglocinfo == 'MOVED_TO_CORE') ):
        #print(func_nm_shrthnd() + f': Going to add {pkgnm}, PR status = {pkgPRstatus}, package location {pkglocinfo}\n')
        rem_list_fl.write(f'{pkgnm}\n');

    # If a package exists in both core and ext and no PR has yet been
    # merged for it then it must be removed from the extended folder.
    # Therefore add it to the remove list of folders
    if ( (pkgPRstatus != 'MERGED') and (pkglocinfo == 'EXISTS_IN_BOTH') ):
        #print(func_nm_shrthnd() + f': Going to add {pkgnm}, PR status = {pkgPRstatus}, package location {pkglocinfo}\n')
        rem_list_fl.write(f'{pkgnm}\n');

    # If a package exists only in ext and needs an upgrade and has not been merged and has 
    # been downloaded successfully then its code needs to be replaced
    # by the new downloaded one.  Therefore, it gets mentioned in the
    # remove list
    # Using pkddnldsuccess != 0 as a test for download success, in order to accomodate for this value to be 1 or more
    if ( (pkglocinfo == 'EXISTS_IN_EXT') and (pkgPRstatus != 'MERGED') and (pkgPRstatus != 'OPEN') and (pkgPRstatus != 'DRAFT') and (pkgdnldsuccess !=0) ):
        if ( (pkgupgddecisionfinal == 'Y') or (pkgupgddecisionfinal == 'Revisit No Dnld Ver') or (pkgupgddecisionfinal == 'Revisit No Bld Ver') or (pkgupgddecisionfinal == 'Revisit Ver Compare')):
            #print(func_nm_shrthnd() + f': Going to add {pkgnm}, PR status = {pkgPRstatus}, Final upgd decision = {pkgupgddecisionfinal}, package location {pkglocinfo}, download success = {pkgdnldsuccess}')
            rem_list_fl.write(f'{pkgnm}\n');

    # General Note: a package that is a "NEW_ADDITION" will not go into either the remove list or copy list.
    # If the PR of this package has been merged then the corresponding directory will be there in SPECS-EXTENDED
    # In that case we will just build this package
    return 0

def  upd_lst_of_copy_folders():
    global copy_list_fl

    #print(func_nm_shrthnd() + f': Entered for package name {pkgnm}, PR status = {pkgPRstatus}, Final upgd decision = {pkgupgddecisionfinal}, package location {pkglocinfo}, download success = {pkgdnldsuccess}\n')

    # if a package exists only in ext and needs an upgrade and has not been merged and has 
    # been downloaded successfully then its code needs to be replaced
    # by the new downloaded one.  Therefore, it gets mentioned in the
    # copy list
    # Using pkddnldsuccess != 0 as a test for download success, in order to accomodate for this value to be 1 or more
    if ( (pkglocinfo == 'EXISTS_IN_EXT') and (pkgPRstatus != 'MERGED') and (pkgPRstatus != 'OPEN') and (pkgPRstatus != 'DRAFT') and (pkgdnldsuccess !=0) ):
        if ( (pkgupgddecisionfinal == 'Y') or (pkgupgddecisionfinal == 'Revisit No Dnld Ver') or (pkgupgddecisionfinal == 'Revisit No Bld Ver') or (pkgupgddecisionfinal == 'Revisit Ver Compare')):
            # if the package name has not changed we mention the original
            # name to the copy list
            # Note that pkgnewnm as 'NA' means that the name has not changed
            if (pkgnewnm == 'NA'):
    #            print(func_nm_shrthnd() + f': Going to add {pkgnm}, PR status = {pkgPRstatus}, package location {pkglocinfo}, download success = {pkgdnldsuccess}\n')
                copy_list_fl.write(f'{pkgnm}\n');
            # if the package name has changed we need to mention the new
            # name in the copy list
            else:
    #            print(func_nm_shrthnd() + f': Going to add {pkgnm}, PR status = {pkgPRstatus}, package location {pkglocinfo}, download success = {pkgdnldsuccess}\n')
                copy_list_fl.write(f'{pkgnewnm}\n');

    # General Note: a package that is a "NEW_ADDITION" will not go into either the remove list or copy list.
    # If the PR of this package has been merged then the corresponding directory will be there in SPECS-EXTENDED
    # In that case we will just build this package

    return 0

